# Keplix AI Environment Variables Example
# Note: Sensitive keys can also be stored securely in your OS Keyring via `keplix init`

# Model Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama / Custom OpenAI-compatible endpoints
OLLAMA_BASE_URL=http://localhost:11434/v1
CUSTOM_OPENAI_BASE_URL=

# Keplix Engine & Telemetry Overrides
KEPLIX_CONFIG_PATH=./keplix.toml
KEPLIX_ENV=development
KEPLIX_LOG_LEVEL=INFO
KEPLIX_BUDGET_USD=2.50
KEPLIX_MAX_RETRIES=3

# Optional Langfuse Telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

