# keplix.toml - Keplix Multi-Agent Orchestrator Configuration Template

[execution]
# Maximum automated retry loops before escalating to human-in-the-loop (HITL)
max_retries = 3

# Hard budget stop (USD) tracked across all agent invocations
budget_usd = 2.50

# Docker image used for ephemeral sandbox containers
sandbox_image = "python:3.12-slim"

# SQLite state checkpointer directory
state_dir = ".keplix"

# Workspace sub-paths excluded from AST index & Git auto-checkpoints
ignore_patterns = [
    ".git",
    "__pycache__",
    ".pytest_cache",
    ".ruff_cache",
    "*.pyc",
    ".keplix",
    "node_modules",
    ".venv"
]

[models.architect]
# Capability tier for high-level decomposition, contract drafting, and reviews
provider = "anthropic"
model_name = "claude-sonnet-4-5"
temperature = 0.2

[models.coder]
# Capability tier for heavy code generation, diff patching, and test writing
provider = "deepseek"
model_name = "deepseek-chat"
temperature = 0.1

[models.fast]
# Capability tier for syntax checks, log pruning, and quick triage
provider = "groq"
model_name = "llama-3.3-70b-versatile"
temperature = 0.0

